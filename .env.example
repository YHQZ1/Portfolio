# Contact form (Vercel function, see api/contact.ts). Never commit real values.
# Put these in Vercel (Project Settings > Environment Variables) and, to try the
# form locally, in .env.local (git-ignored).

# Required: your Resend API key.
RESEND_API_KEY=

# Optional: the sender. Defaults to "Portfolio Contact <onboarding@resend.dev>".
# Use an address on a domain you have verified in Resend to send from your own domain.
# Messages are always delivered to the address in src/data/site.ts.
CONTACT_FROM_EMAIL=
